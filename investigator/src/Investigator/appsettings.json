{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "Warning",
      "Microsoft.AspNetCore.Components.RenderTree": "Warning",
      "Microsoft.AspNetCore.SignalR.HubConnectionHandler": "Debug"
    }
  },
  "AllowedHosts": "*",

  "Tools": {
    "run_aws": {},
    "run_oc": {
      "Clusters": [
      ]
    },
    "ci_repo": {
      "Repos": {
        "release": { "LocalPath": "/data/release-repo", "ShallowClone": false },
        "ci-tools": { "LocalPath": "/data/ci-tools-repo", "ShallowClone": false }
      }
    },
    "casebook": {
      "Path": "/data/investigator/casebook",
      "CommonplacePath": "/data/investigator/casebook/commonplace",
      "SeedPath": "skills",
      "MaxEntries": 500,
      "SearchResults": 5,
      "ListDefault": 20,
      "Indexing": {
        "Enabled": true,
        "Interval": "7.00:00:00",
        "MinEntries": 5,
        "ContextBatchSize": 100
      }
    }
  },

  "Workspace": {
    "RootPath": "/data/investigator/workspaces"
  },

  "Llm": {
    "Primary": "claude-opus",
    "Default": "claude-sonnet",
    "Summarizer": "claude-sonnet",
    "Providers": {
      "vertex": {}
    },
    "Models": {
      "claude-opus": {
        "Provider": "vertex",
        "Region": "us-east5",
        "ProjectId": "",
        "Model": "claude-opus-4-6",
        "EmbeddingModel": "gemini-embedding-001",
        "MaxTokens": 128000,
        "ThinkingBudget": 32000,
        "Strengths": "Deep reasoning, complex multi-step analysis, tool orchestration",
        "InputPricePerMToken": 5.00,
        "OutputPricePerMToken": 25.00,
        "CacheReadPricePerMToken": 0.50,
        "CacheCreationPricePerMToken": 6.25
      },
      "claude-sonnet": {
        "Provider": "vertex",
        "Region": "us-east5",
        "ProjectId": "",
        "Model": "claude-sonnet-4-6",
        "MaxTokens": 32000,
        "ThinkingBudget": 16000,
        "Strengths": "Fast, cheap, good enough for straightforward tasks like log fetching, config reading, simple lookups",
        "InputPricePerMToken": 3.00,
        "OutputPricePerMToken": 15.00,
        "CacheReadPricePerMToken": 0.30,
        "CacheCreationPricePerMToken": 3.75
      }
    }
  },

  "Agent": {
    "MaxToolCalls": 256
  }
}
